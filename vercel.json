{
  "cleanUrls": true,
  "trailingSlash": false,
  "outputDirectory": "public",
  "framework": null,
  "buildCommand": null,
  "installCommand": null,
  "functions": {
    "api/radar.js": {
      "maxDuration": 60
    },
    "api/check.js": {
      "maxDuration": 60
    },
    "api/warm.js": {
      "maxDuration": 60
    },
    "api/mcp.js": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/warm",
      "schedule": "7 * * * *"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/mcp",
      "destination": "/api/mcp"
    }
  ]
}