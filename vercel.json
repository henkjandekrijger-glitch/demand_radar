{
  "cleanUrls": true,
  "trailingSlash": false,
  "outputDirectory": "public",
  "framework": null,
  "buildCommand": null,
  "installCommand": null,
  "functions": {
    "api/radar.js": {
      "maxDuration": 60
    },
    "api/check.js": {
      "maxDuration": 60
    },
    "api/warm.js": {
      "maxDuration": 300
    },
    "api/mcp.js": {
      "maxDuration": 60
    },
    "api/daily.js": {
      "maxDuration": 300
    },
    "api/loop.js": {
      "maxDuration": 60
    },
    "api/learn.js": {
      "maxDuration": 30
    },
    "api/status.js": {
      "maxDuration": 60
    },
    "api/map.js": {
      "maxDuration": 300
    },
    "api/warmmap.js": {
      "maxDuration": 300
    }
  },
  "crons": [
    {
      "path": "/api/warm",
      "schedule": "7 * * * *"
    },
    {
      "path": "/api/loop",
      "schedule": "23 * * * *"
    },
    {
      "path": "/api/daily",
      "schedule": "40 5 * * *"
    },
    {
      "path": "/api/warmmap",
      "schedule": "15 4 * * *"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    },
    {
      "source": "/api/((?!status).*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/mcp",
      "destination": "/api/mcp"
    },
    {
      "source": "/leren/:key",
      "destination": "/api/learn?key=:key&html=1"
    }
  ],
  "redirects": [
    {
      "source": "/radar",
      "destination": "/",
      "permanent": false
    }
  ]
}